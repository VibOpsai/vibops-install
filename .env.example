# ============================================================
# VibOps — Environment variables
# ============================================================
# Copy this file to ".env" and fill in the values.
#   cp .env.example .env
# Never commit .env to git (see .gitignore).
# ============================================================


# ─── Licence ─────────────────────────────────────────────────
# Your VibOps licence key — provided by VibOps at contract signing.
# Without a key, VibOps runs in trial mode (14 days, limited to
# 10 GPUs / 5 users / 2 clusters). Contact david@vibops.ai to get a key.
VIBOPS_LICENCE_KEY=

# ─── Database ────────────────────────────────────────────────
# Generated automatically by: make quickstart
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://vibops:${POSTGRES_PASSWORD}@postgres:5432/vibops_db


# ─── Redis (Celery broker) ───────────────────────────────────
# Password for Redis authentication (--requirepass).
# REQUIRED — the stack refuses to start without it.
#   openssl rand -hex 24
# It used to fall back to `vibops-dev`, a value published in the compose file
# served at vibops.ai, so an operator who skipped this line got a Redis
# protected by a password anyone could read.
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0


# ─── Security ────────────────────────────────────────────────
# Change in production — use: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Vault: Fernet encryption key for secrets stored in DB
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_KEY=


# ─── Backups ─────────────────────────────────────────────────
# Encrypts the nightly archives (AES-256-CBC). Leave empty and they are
# written in the clear, which is what installs before 03/10/2026 did.
#
# ⚠ THIS KEY IS THE ONLY ONE. Lose it and the thirty days of archives — and
# every off-host copy of them — can no longer be opened, by you or by us.
# Keep a copy of this file somewhere other than this machine.
#
# `make quickstart` and `install.sh` generate one for a new install.
BACKUP_PASSPHRASE=
# PBKDF2 iterations. Raise it, never lower it: each archive records the count
# it was written with, so lowering this weakens new archives only.
BACKUP_ITER=600000

# ─── JWT / Auth ──────────────────────────────────────────────
# Bootstrap admin — created automatically on first start if the DB is empty.
# Change these before first launch in production.
ADMIN_EMAIL=admin@vibops.local
ADMIN_PASSWORD=changeme
JWT_SECRET_KEY=change-me-jwt-secret-in-production
JWT_EXPIRE_HOURS=24


# ─── LLM Provider ────────────────────────────────────────────
# Choose one: claude | openai | ollama
LLM_PROVIDER=claude

# API key for your LLM provider:
#   claude  → Anthropic key  (https://console.anthropic.com/settings/keys)
#   openai  → OpenAI/provider key (https://platform.openai.com/api-keys)
#   ollama  → leave empty (no key required)
LLM_API_KEY=

# Model to use. Examples:
#   claude  → claude-sonnet-5 (default), claude-opus-5, claude-haiku-4-5
#   openai  → gpt-4o, gpt-4o-mini
#   ollama  → llama3.1, mistral, qwen2.5
LLM_MODEL=claude-sonnet-5

# Profondeur de raisonnement (provider=claude, modeles en mode adaptatif) :
#   low | medium | high (defaut) | xhigh | max
# Remplace THINKING_BUDGET_TOKENS, inoperant des que le modele passe en adaptive.
# Ignore par Haiku 4.5 et les generations < 4.6. xhigh exige la 4.7 ou plus recent.
THINKING_EFFORT=high

# Base URL — required only for openai (on-prem endpoint, e.g. vLLM, Mistral)
# Leave empty for claude or ollama.
# Example: http://vllm-service:8000/v1
LLM_BASE_URL=

# Ollama endpoint (required only when LLM_PROVIDER=ollama)
# docker-compose: http://ollama:11434  |  local dev: http://localhost:11434
OLLAMA_URL=http://ollama:11434


# ─── Datadog (optional) ──────────────────────────────────────
# Leave empty to disable.
# Get keys at: https://app.datadoghq.com/organization-settings/api-keys
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com


# ─── Git provider (optional) ─────────────────────────────────
# Choose: github | gitlab
GIT_PROVIDER=github

# Personal Access Token — scope: repo:read (GitHub) or read_api (GitLab)
# GitHub: https://github.com/settings/tokens
# GitLab: https://gitlab.example.com/-/profile/personal_access_tokens
GIT_TOKEN=

# Base URL for self-hosted GitLab (leave empty or default for gitlab.com)
GIT_URL=https://gitlab.com

# Shared secret for incoming webhooks
# GitHub: Repo > Settings > Webhooks
# GitLab: Repo > Settings > Integrations
GITHUB_WEBHOOK_SECRET=


# ─── Grafana (optional — observability profile) ──────────────
# Public Grafana URL reachable from the browser.
# Enable: docker compose --profile observability up
# Default: http://localhost:3000
GRAFANA_PUBLIC_URL=http://localhost:3000
# Generated automatically by: make quickstart
GRAFANA_PASSWORD=


# ─── Connect Gateway (optional — connect profile) ────────────
# Generate via VibOps console → Connect tab → Register gateway
CONNECT_GATEWAY_ID=
CONNECT_TOKEN=


# ─── Email (SMTP) — password reset + alerts ──────────────────
# Leave SMTP_HOST empty to disable (dev mode: token shown in UI).
# Examples:
#   Gmail/Workspace : smtp.gmail.com        port 587  (App Password required)
#   SendGrid        : smtp.sendgrid.net     port 587  user=apikey  password=SG.xxx
#   AWS SES         : email-smtp.<region>.amazonaws.com  port 587
#   Mailgun         : smtp.mailgun.org      port 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourcompany.com


# ─── Internal URLs (docker-compose — do not change) ──────────
CORE_API_URL=http://core:8000
AGENT_API_URL=http://agent:8001

# Anonymous access: token-less requests become the reserved admin ONLY when
# this is 1 AND APP_ENV=development. Off by default since v0.72.4; refused in production.
# Turn it on for a throwaway local stack only (the smoke test needs it).
ALLOW_ANONYMOUS=0

# ─── Hardening (set by `make quickstart` and install.sh) ─────
# APP_ENV: `production` turns on the production refusals, secure cookies and
# closes /docs and /metrics. Keep `development` for a local loopback stack
# (secure cookies need HTTPS); a real deployment sets `production`.
APP_ENV=development
# INTERNAL_API_KEY: gates service-to-service routes; empty closes them.
# Generate with `openssl rand -hex 32`.
INTERNAL_API_KEY=
# APP_ROLE_PASSWORD: the password of the non-superuser role the app connects
# as, so PostgreSQL Row Level Security enforces tenant isolation (ADR 0047).
# EMPTY = the app keeps the owner connection and RLS does NOT apply.
# Generate with `openssl rand -hex 24`.
APP_ROLE_PASSWORD=
